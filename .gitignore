# ------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.env.bak

# ------------------------------------------
# Django & Local Database
# ------------------------------------------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3

# ------------------------------------------
# Node.js & Frontend Assets
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------
